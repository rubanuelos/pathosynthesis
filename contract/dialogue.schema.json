{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathosynthesis.local/contract/dialogue.schema.json",
  "title": "Pathosynthesis Dialogue",
  "description": "Contract v0.3. The questionnaire so far: orchestrator (03) -> interpretation (01). GENERATED by build_schemas.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "session_id",
    "exchanges"
  ],
  "properties": {
    "contract_version": {
      "const": "0.3"
    },
    "session_id": {
      "type": "string",
      "maxLength": 64
    },
    "lang": {
      "type": "string",
      "maxLength": 16,
      "description": "BCP-47, detected from the first answer."
    },
    "exchanges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer",
          "status"
        ],
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 200
          },
          "answer": {
            "type": "string",
            "maxLength": 2000
          },
          "status": {
            "enum": [
              "ok",
              "silence",
              "timeout"
            ]
          },
          "speech_s": {
            "type": "number",
            "minimum": 0
          },
          "turn": {
            "$ref": "turn.schema.json",
            "description": "The interpretation turn returned after this answer, once known."
          }
        }
      }
    }
  }
}
