{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathosynthesis.local/contract/turn.schema.json",
  "title": "Pathosynthesis Questionnaire Turn",
  "description": "Contract v0.3. Interpretation (01) -> orchestrator (03), after each answer. GENERATED by build_schemas.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "planned_questions",
    "hypothesis"
  ],
  "properties": {
    "action": {
      "enum": [
        "ask",
        "compose"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Required when action=ask. Spoken aloud by the voice node."
    },
    "planned_questions": {
      "type": "integer",
      "minimum": 2,
      "maximum": 5,
      "description": "Current estimate of how many questions this visitor needs in total, counting the opening one."
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "description": "The working guess the next question is aimed at. Logged; never spoken.",
      "required": [
        "confidence"
      ],
      "properties": {
        "diagram": {
          "enum": [
            "fate-engage",
            "habit-build",
            "mystery-engage"
          ]
        },
        "at": {
          "type": "string",
          "maxLength": 40
        },
        "mirror_emotion": {
          "enum": [
            "absence",
            "admiration",
            "allure",
            "ambiguity",
            "ambition",
            "anxiety",
            "appetite",
            "aspiration",
            "attachment",
            "attraction",
            "awe",
            "belonging",
            "care",
            "catastrophe",
            "chance",
            "choice",
            "clumsiness",
            "coercion",
            "comfort",
            "commitment",
            "communion",
            "competence",
            "compulsion",
            "conquest",
            "dependency",
            "desecration",
            "desire",
            "destiny",
            "destruction",
            "devotion",
            "dignity",
            "disappointment",
            "dissipation",
            "domination",
            "escalation",
            "excitement",
            "expansion",
            "expectation",
            "faith",
            "fantasy",
            "fate",
            "fear",
            "fragility",
            "gamble",
            "glory",
            "grace",
            "greed",
            "harmony",
            "hope",
            "hypervigilance",
            "idealization",
            "illegibility",
            "infatuation",
            "insecurity",
            "intensification",
            "intimacy",
            "justice",
            "lack",
            "leakage",
            "legitimacy",
            "longing",
            "loss",
            "luxury",
            "meaning",
            "mercy",
            "mystery",
            "necessity",
            "need",
            "obligation",
            "obsession",
            "opportunity",
            "patience",
            "peace",
            "permission",
            "play",
            "possession",
            "possibility",
            "power",
            "precarity",
            "prohibition",
            "prowess",
            "pursuit",
            "recognition",
            "recovery",
            "refusal",
            "renunciation",
            "repression",
            "reserves",
            "restraint",
            "revelation",
            "risk",
            "romance",
            "sacredness",
            "sacrifice",
            "safety",
            "seduction",
            "seeking",
            "serenity",
            "significance",
            "spiral",
            "stabilization",
            "status",
            "submission",
            "suffering",
            "surplus",
            "synchronicity",
            "taboo",
            "temptation",
            "threat",
            "transcendence",
            "transgression",
            "uncertainty",
            "understanding",
            "union",
            "urge",
            "urgency",
            "vigilance",
            "violation",
            "void",
            "vulnerability",
            "wishing",
            "witness",
            "worship"
          ]
        },
        "trajectory": {
          "enum": [
            "hold",
            "amplify",
            "dissolve",
            "release",
            "transmute"
          ]
        },
        "length": {
          "enum": [
            "brief",
            "medium",
            "long"
          ]
        },
        "unknown": {
          "type": "string",
          "maxLength": 200,
          "description": "What the next question is trying to find out."
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "ask"
          }
        }
      },
      "then": {
        "required": [
          "question"
        ]
      }
    }
  ]
}
