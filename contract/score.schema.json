{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathosynthesis.local/contract/score.schema.json",
  "title": "Pathosynthesis Score",
  "description": "Contract v0.3. Interpretation (01) -> orchestrator (03). Semantic choices only. GENERATED by build_schemas.py; do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "diagram",
    "mirror_emotion",
    "mixture",
    "tension",
    "intention",
    "intention_source",
    "trajectory",
    "length",
    "movements"
  ],
  "$defs": {
    "emotion": {
      "enum": [
        "absence",
        "admiration",
        "allure",
        "ambiguity",
        "ambition",
        "anxiety",
        "appetite",
        "aspiration",
        "attachment",
        "attraction",
        "awe",
        "belonging",
        "care",
        "catastrophe",
        "chance",
        "choice",
        "clumsiness",
        "coercion",
        "comfort",
        "commitment",
        "communion",
        "competence",
        "compulsion",
        "conquest",
        "dependency",
        "desecration",
        "desire",
        "destiny",
        "destruction",
        "devotion",
        "dignity",
        "disappointment",
        "dissipation",
        "domination",
        "escalation",
        "excitement",
        "expansion",
        "expectation",
        "faith",
        "fantasy",
        "fate",
        "fear",
        "fragility",
        "gamble",
        "glory",
        "grace",
        "greed",
        "harmony",
        "hope",
        "hypervigilance",
        "idealization",
        "illegibility",
        "infatuation",
        "insecurity",
        "intensification",
        "intimacy",
        "justice",
        "lack",
        "leakage",
        "legitimacy",
        "longing",
        "loss",
        "luxury",
        "meaning",
        "mercy",
        "mystery",
        "necessity",
        "need",
        "obligation",
        "obsession",
        "opportunity",
        "patience",
        "peace",
        "permission",
        "play",
        "possession",
        "possibility",
        "power",
        "precarity",
        "prohibition",
        "prowess",
        "pursuit",
        "recognition",
        "recovery",
        "refusal",
        "renunciation",
        "repression",
        "reserves",
        "restraint",
        "revelation",
        "risk",
        "romance",
        "sacredness",
        "sacrifice",
        "safety",
        "seduction",
        "seeking",
        "serenity",
        "significance",
        "spiral",
        "stabilization",
        "status",
        "submission",
        "suffering",
        "surplus",
        "synchronicity",
        "taboo",
        "temptation",
        "threat",
        "transcendence",
        "transgression",
        "uncertainty",
        "understanding",
        "union",
        "urge",
        "urgency",
        "vigilance",
        "violation",
        "void",
        "vulnerability",
        "wishing",
        "witness",
        "worship"
      ],
      "description": "Vocabulary from the Nicolae diagrams. Provenance: emotion_vocabulary.json."
    },
    "weighted_emotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emotion",
        "weight"
      ],
      "properties": {
        "emotion": {
          "$ref": "#/$defs/emotion"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "heard": {
          "type": "string",
          "maxLength": 60,
          "description": "Optional. The visitor's own word this term translates. Logged; never sent to SuperCollider."
        }
      }
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "at",
        "span",
        "heartbeat",
        "chord",
        "transition"
      ],
      "properties": {
        "phase": {
          "enum": [
            "mirror",
            "dwell",
            "transform",
            "resurface"
          ]
        },
        "at": {
          "enum": [
            "absence",
            "action",
            "allure",
            "awe",
            "behavior",
            "desire",
            "destiny",
            "disappointment",
            "expectation",
            "faith",
            "fate",
            "habit",
            "hope",
            "intention",
            "longing",
            "loss",
            "mystery",
            "nature",
            "need",
            "patience",
            "point",
            "void",
            "vulnerability"
          ],
          "description": "Where in the chosen diagram this movement sits. Must be a position of `diagram` (enforced below)."
        },
        "span": {
          "enum": [
            "short",
            "medium",
            "long"
          ],
          "description": "Relative length of this movement. The orchestrator turns `length` + spans into seconds."
        },
        "heartbeat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tempo",
            "regularity",
            "weight"
          ],
          "properties": {
            "tempo": {
              "enum": [
                "very_slow",
                "slow",
                "resting",
                "elevated",
                "racing"
              ]
            },
            "regularity": {
              "enum": [
                "steady",
                "uneven",
                "erratic"
              ]
            },
            "weight": {
              "enum": [
                "faint",
                "present",
                "heavy"
              ]
            }
          }
        },
        "chord": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "register",
            "color",
            "density",
            "brightness"
          ],
          "properties": {
            "register": {
              "enum": [
                "low",
                "mid",
                "high"
              ]
            },
            "color": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "unison",
                  "min2",
                  "maj2",
                  "min3",
                  "maj3",
                  "p4",
                  "tritone",
                  "p5",
                  "min6",
                  "maj6",
                  "min7",
                  "maj7",
                  "octave"
                ]
              },
              "description": "Intervals above the root, ordered by prominence."
            },
            "density": {
              "enum": [
                "sparse",
                "medium",
                "thick"
              ]
            },
            "brightness": {
              "enum": [
                "dark",
                "veiled",
                "clear",
                "bright"
              ]
            }
          }
        },
        "transition": {
          "enum": [
            "cut",
            "glide",
            "slow_glide"
          ]
        }
      }
    }
  },
  "properties": {
    "contract_version": {
      "const": "0.3"
    },
    "diagram": {
      "enum": [
        "fate-engage",
        "habit-build",
        "mystery-engage"
      ],
      "description": "Which diagram frames the piece. Only active diagrams (diagrams.json)."
    },
    "mirror_emotion": {
      "$ref": "#/$defs/emotion",
      "description": "The first emotion to mirror (iso principle). Must also appear in `mixture`."
    },
    "mixture": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/weighted_emotion"
      }
    },
    "destination": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/weighted_emotion"
      }
    },
    "tension": {
      "type": "string",
      "maxLength": 200
    },
    "intention": {
      "type": "string",
      "maxLength": 500
    },
    "intention_source": {
      "enum": [
        "stated",
        "inferred"
      ],
      "description": "stated = the visitor said it; inferred = read from their answers."
    },
    "negotiation": {
      "type": "string",
      "maxLength": 240
    },
    "trajectory": {
      "enum": [
        "hold",
        "amplify",
        "dissolve",
        "release",
        "transmute"
      ]
    },
    "length": {
      "enum": [
        "brief",
        "medium",
        "long"
      ],
      "description": "Duration of the piece after the questionnaire. Seconds set by the orchestrator."
    },
    "movements": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/movement"
            },
            {
              "type": "object",
              "required": [
                "phase"
              ],
              "properties": {
                "phase": {
                  "const": "mirror"
                }
              }
            }
          ]
        }
      ],
      "items": {
        "$ref": "#/$defs/movement"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "phase"
            ],
            "properties": {
              "phase": {
                "const": "mirror"
              }
            }
          },
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "phase"
            ],
            "properties": {
              "phase": {
                "const": "dwell"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "phase"
            ],
            "properties": {
              "phase": {
                "const": "resurface"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 80
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "diagram": {
            "const": "fate-engage"
          }
        }
      },
      "then": {
        "properties": {
          "movements": {
            "items": {
              "properties": {
                "at": {
                  "enum": [
                    "fate",
                    "point",
                    "destiny"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "diagram": {
            "const": "habit-build"
          }
        }
      },
      "then": {
        "properties": {
          "movements": {
            "items": {
              "properties": {
                "at": {
                  "enum": [
                    "intention",
                    "action",
                    "behavior",
                    "habit",
                    "nature"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "diagram": {
            "const": "mystery-engage"
          }
        }
      },
      "then": {
        "properties": {
          "movements": {
            "items": {
              "properties": {
                "at": {
                  "enum": [
                    "longing",
                    "faith",
                    "awe",
                    "loss",
                    "expectation",
                    "void",
                    "allure",
                    "need",
                    "disappointment",
                    "patience",
                    "mystery",
                    "desire",
                    "vulnerability",
                    "hope",
                    "absence"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
